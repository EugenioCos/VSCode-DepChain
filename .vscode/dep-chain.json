{
  "workingDir": "/Users/ab/Documents/progetti/VSCode Extension/example repos",
  "onDirty": "fail",
  "setups": {
    "dev": {
      "description": "Checkout the branches and run the pack chain successfully.",
      "steps": [
        { "repo": "repo1", "branch": "branch-1", "shell": "npm run cmd1" },
        { "repo": "repo2", "branch": "branch-2", "shell": "npm run cmd2" },
        { "repo": "repo3", "branch": "branch-3", "shell": "npm run cmd3" }
      ],
      "cmdstart": "node -e \"setInterval(() => {}, 1000)\""
    },
    "failure": {
      "description": "Test fail-loud: repo1 runs exit1 (exit code 1) and the chain stops before repo2.",
      "steps": [
        { "repo": "repo1", "branch": "branch-1", "shell": "npm run exit1" },
        { "repo": "repo2", "branch": "branch-2", "shell": "npm run cmd2" }
      ]
    }
  }
}
